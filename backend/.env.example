# Copy this file to .env and fill in your own values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/monsoonmap

# No geocoding API key needed — the backend uses OpenStreetMap's free
# Nominatim service (see routes/geocode.js), which requires no key or
# billing account.

# Public URL for this backend, used by /api/export/kml to build absolute
# photo links (Google Earth loads over the internet, so localhost won't work).
# While developing, run `npx ngrok http 5000` and paste the https URL here.
# In production, use your deployed backend's URL.
PUBLIC_BASE_URL=http://localhost:5000
