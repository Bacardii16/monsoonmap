# Copy this file to .env and fill in your own value

# Google Maps JavaScript API key — see console.cloud.google.com
# Requires the "Maps JavaScript API" enabled and billing linked to the
# project (free monthly credit covers normal dev/student usage).
#VITE_GOOGLE_MAPS_API_KEY=
# No API keys needed anymore — the map uses free OpenStreetMap tiles via
# Leaflet, and routing uses OSRM's free public API. Nothing to fill in here.
