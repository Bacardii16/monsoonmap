<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>MonsoonMap — Sample Reports (Water + Potholes)</name>
    <description>Static sample export showing both report types. This is NOT connected to live data — it's here so you can see the new pothole markers/icons in Google Earth immediately. For the real auto-refreshing version, generate one from your running backend at /api/export/kml-networklink (see exports/README.md).</description>

    <!-- Waterlogging styles: circle icon, blue/green/red -->
    <Style id="clear">
      <IconStyle>
        <color>ff98d53e</color>
        <scale>1.0</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="minor">
      <IconStyle>
        <color>ff66d1ff</color>
        <scale>1.1</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="difficult">
      <IconStyle>
        <color>ff4a9eff</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="impassable">
      <IconStyle>
        <color>ff5c5cff</color>
        <scale>1.3</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href></Icon>
      </IconStyle>
    </Style>

    <!-- Pothole styles: target icon, brown/blue tones so they read as a
         different marker type from waterlogging at a glance -->
    <Style id="small">
      <IconStyle>
        <color>ff6ba6c9</color>
        <scale>1.0</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/target.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="medium">
      <IconStyle>
        <color>ff2f70b5</color>
        <scale>1.1</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/target.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="large">
      <IconStyle>
        <color>ff13458b</color>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/target.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="hazardous">
      <IconStyle>
        <color>ff0c2c5c</color>
        <scale>1.3</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/shapes/target.png</href></Icon>
      </IconStyle>
    </Style>

    <Folder>
      <name>Waterlogging (sample)</name>

      <Placemark>
        <name>Hindmata</name>
        <styleUrl>#impassable</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <img src="https://picsum.photos/seed/hindmata/300/200" width="260" style="border-radius:6px;" /><br/><br/>
            <b>Type:</b> Waterlogging<br/>
            <b>Severity:</b> Impassable<br/>
            <b>Reported:</b> 2026-07-14<br/>
            <i>Sample entry — edit or delete after import</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8397,19.0032,0</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Milan Subway, Andheri</name>
        <styleUrl>#impassable</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <img src="https://picsum.photos/seed/milansubway/300/200" width="260" style="border-radius:6px;" /><br/><br/>
            <b>Type:</b> Waterlogging<br/>
            <b>Severity:</b> Impassable<br/>
            <b>Reported:</b> 2026-07-14<br/>
            <i>Sample entry — edit or delete after import</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8484,19.1144,0</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Sion Circle</name>
        <styleUrl>#difficult</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <img src="https://picsum.photos/seed/sioncircle/300/200" width="260" style="border-radius:6px;" /><br/><br/>
            <b>Type:</b> Waterlogging<br/>
            <b>Severity:</b> Difficult to pass<br/>
            <b>Reported:</b> 2026-07-14<br/>
            <i>Sample entry — edit or delete after import</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8656,19.0448,0</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Kurla West</name>
        <styleUrl>#minor</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <b>Type:</b> Waterlogging<br/>
            <b>Severity:</b> Minor waterlogging<br/>
            <b>Reported:</b> 2026-07-14<br/>
            <i>Sample entry — edit or delete after import</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8826,19.0728,0</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Dadar TT</name>
        <styleUrl>#clear</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <b>Type:</b> Waterlogging<br/>
            <b>Severity:</b> Clear<br/>
            <b>Reported:</b> 2026-07-14<br/>
            <i>Sample entry — edit or delete after import</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8478,19.0178,0</coordinates></Point>
      </Placemark>
    </Folder>

    <Folder>
      <name>Potholes / road damage (preloaded seed data)</name>

      <Placemark>
        <name>LBS Marg, Kurla West</name>
        <styleUrl>#large</styleUrl>
        <description><![CDATA[
          <div style="font-family: sans-serif; max-width: 260px;">
            <img src="https://picsum.photos/seed/lbsmarg/300/200" width="260" style="border-radius:6px;" /><br/><br/>
            <b>Type:</b> Pothole / road damage<br/>
            <b>Severity:</b> Large pothole<br/>
            <b>Notes:</b> Recurring pothole stretch reported in past monsoons near the flyover approach — verify current condition.<br/>
            <i>Preloaded reference marker — verify before relying on it</i>
          </div>
        ]]></description>
        <Point><coordinates>72.8788,19.0721,0</coordinates></Point>
      </Placemark>

      <Placemark>
        <name>Sion-Trombay Road, Sion</name>
